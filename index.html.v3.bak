      "Los Ángeles, Estados Unidos",
      "Moscú, Rusia",
      "Estambul, Turquía",
      "Shanghai, China",
      "Bogotá, Colombia",
      "Lima, Perú",
      "Santiago, Chile",
      "Montevideo, Uruguay",
      "La Habana, Cuba",
      "Lisboa, Portugal",
      "Ámsterdam, Países Bajos",
      "Viena, Austria",
      "Praga, República Checa",
      "El Cairo, Egipto",
      "Lagos, Nigeria",
      "Mumbai, India",
      "Sydney, Australia",
      "Toronto, Canadá"
    ];

    let _citySearchTimeout = null;

    async function searchCitiesNominatim(query) {
      if (query.length < 3) return [];
      try {
        const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(query)}&featuretype=city&limit=6&format=json&accept-language=es`;
        const res = await fetch(url, {
          headers: { 'Accept-Language': 'es' }
        });
        const data = await res.json();
        return data.map(r => r.display_name.split(',').slice(0, 2).join(',').trim());
      } catch {
        return []; // Silencioso — fallback a hardcodeadas
      }
    }

    function renderCityDropdown(suggestions) {
      const cityDropdown = document.getElementById('cityDropdown');
      cityDropdown.innerHTML = '';
      if (suggestions.length === 0) {
        cityDropdown.style.display = 'none';
        return;
      }
      suggestions.forEach(city => {
        const item = document.createElement('div');
        item.className = 'city-suggestion-item';
        item.textContent = city;
        item.addEventListener('click', () => {
          document.getElementById('inputCiudad').value = city;
          cityDropdown.style.display = 'none';
        });
        cityDropdown.appendChild(item);
      });
      cityDropdown.style.display = 'block';
    }

    function setupCityAutocomplete() {
      const cityInput = document.getElementById('inputCiudad');
      const cityDropdown = document.getElementById('cityDropdown');

      cityInput.addEventListener('focus', () => {
        if (cityInput.disabled) return;
        const q = cityInput.value.trim();
        if (q.length === 0) {
          renderCityDropdown(CIUDADES_FAMOSAS.slice(0, 9));
        }
      });

      cityInput.addEventListener('input', () => {
        if (cityInput.disabled) return;
        const q = cityInput.value.trim();

        clearTimeout(_citySearchTimeout);

        if (q.length === 0) {
          renderCityDropdown(CIUDADES_FAMOSAS.slice(0, 9));
          return;
        }

        if (q.length < 3) {
          const filtered = CIUDADES_FAMOSAS.filter(c => c.toLowerCase().includes(q.toLowerCase()));
          renderCityDropdown(filtered.slice(0, 8));
          return;
        }

        // Debounce 300ms for Nominatim (solo si no coincide con las hardcodeadas y no es aleatoria)
        _citySearchTimeout = setTimeout(async () => {
          const hardFiltered = CIUDADES_FAMOSAS.filter(c => c.toLowerCase().includes(q.toLowerCase()));
          let dynamic = [];
          if (hardFiltered.length === 0 && !q.toLowerCase().includes('aleatoria')) {
            dynamic = await searchCitiesNominatim(q);
          }
          const all = [...new Set([...hardFiltered, ...dynamic])];
          renderCityDropdown(all.slice(0, 8));
        }, 300);
      });

      // Close dropdown on click outside
      document.addEventListener('click', (e) => {
        if (!cityInput.contains(e.target) && !cityDropdown.contains(e.target)) {
          cityDropdown.style.display = 'none';
        }
      });
    }

    /* ============================================================
       IMPORT / EXPORT CASES
       ============================================================ */
    function exportCase() {
      const pub = AppState.currentPublicInfo;
      const tru = AppState.currentTruth;

      if (!pub || !tru) {
        alert('No hay un caso activo para exportar.');
        return;
      }

      const exportData = {
        veredikt_version: "1.0",
        exported_at: new Date().toISOString(),
        publicInfo: pub,
        truth: tru
      };

      const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      const safeName = (pub.titulo || 'caso').toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').substring(0, 40);
      a.download = `veredikt-${safeName}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function importCase(file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const data = JSON.parse(e.target.result);

          // Validación mínima
          if (!data.publicInfo || !data.truth) {
            throw new Error("El archivo no es un caso de VEREDIKT válido. Debe contener 'publicInfo' y 'truth'.");
          }
          if (!data.publicInfo.sospechosos || !data.publicInfo.evidencias) {
            throw new Error("El caso está incompleto o corrupto: faltan sospechosos o evidencias.");
          }

          // Cargar en AppState
          AppState.currentPublicInfo = data.publicInfo;
          AppState.currentTruth = data.truth;
          AppState.forensicsUsed = 0;
          AppState.interrogationsState = {};
          AppState.isOfflineMode = false;

          // Guardar en localStorage
          SafeStorage.setItem('caso_publicInfo', JSON.stringify(data.publicInfo));
          SafeStorage.setItem('caso_truth', obfuscateTruth(data.truth));

          // Ir directo a la pantalla de investigación
          renderInvestigationDossier();
          showScreen('screenInvestigation');

        } catch (err) {
          alert(`Error al importar: ${err.message}`);
        }
      };
      reader.readAsText(file);
    }

    /* ============================================================
       PROGRESS BAR HELPER — 6 PASOS (v3.1)
       ============================================================ */
    const PASOS = [
      "① Abriendo el expediente...",
      "② Identificando sospechosos...",
      "③ Registrando evidencias...",
      "④ Preparando interrogatorios...",
      "⑤ Procesando laboratorio forense...",
      "⑥ Sellando la verdad del caso..."
    ];

    function setProgress(paso) { // paso: 1 a 6
      const pct = ((paso - 1) / 6) * 100;
      const bar = document.getElementById('progressBarFill');
      if (bar) bar.style.width = pct + '%';
      const label = document.getElementById('progressLabel');
      if (label) label.textContent = PASOS[paso - 1] || '';

      for (let i = 1; i <= 6; i++) {
        const stepEl = document.getElementById(`pStep${i}`);
        if (!stepEl) continue;
        stepEl.classList.remove('active', 'done');
        if (i < paso) {
          stepEl.classList.add('done');
        } else if (i === paso) {
          stepEl.classList.add('active');
        }
      }
    }

    /* ============================================================
       PROMPTS DE GENERACIÓN — 6 LLAMADAS QUIRÚRGICAS
       ============================================================ */
    function buildPrompt1A(ciudad, dificultad) {
      const ciudadParam = (!ciudad || ciudad.includes("Aleatoria")) ? "Aleatoria" : ciudad.trim();
      return `Sos el autor de un juego de misterio policial. Generá solo el encabezado de un caso criminal.

PARÁMETROS:
- Ciudad: ${ciudadParam}
- Dificultad: ${dificultad}

Decidí vos: el tipo de crimen, la época histórica y la atmósfera según la ciudad.
Si la ciudad es "Aleatoria", elegí vos cualquier ciudad y época del mundo.

Devolvé ÚNICAMENTE este JSON sin texto extra ni markdown:

{
  "titulo": "string — título dramático del caso",
  "ciudad": "string — ciudad y país",
  "epoca": "string — ej: Buenos Aires, 1943 o Londres, 1987",
  "tipo_crimen": "string — ej: homicidio, desaparición, fraude",
  "atmosfera": "string — 1 oración describiendo el tono del caso",
  "victima": {
    "nombre": "string",
    "descripcion": "string — 1 oración"
  },
  "descripcionEscena": "string — 2 oraciones describiendo el lugar del crimen",
  "informeGeneral": "string — 2 oraciones del informe policial oficial"
}`;
    }

    function buildPrompt1B(base, dificultad) {
      return `Sos el autor de un juego de misterio policial. Generá los sospechosos del caso.

CONTEXTO DEL CASO:
- Título: ${base.titulo}
- Ciudad/Época: ${base.epoca}
- Crimen: ${base.tipo_crimen}
- Víctima: ${base.victima.nombre} — ${base.victima.descripcion}
- Escena: ${base.descripcionEscena}

REGLAS:
- Dificultad "${dificultad}": ${dificultad === 'Fácil' ? '3 sospechosos, culpable con coartada débil' : dificultad === 'Normal' ? '4 sospechosos, más de uno creíble' : '4 sospechosos, culpable con coartada sólida y red herrings'}
- Uno de ellos ES el culpable real — decidí vos cuál
- Cada campo: máximo 2 oraciones
- Los ids van de s1 a s3 o s4 según corresponda

Devolvé ÚNICAMENTE este JSON sin texto extra ni markdown:

{
  "culpable_id": "s2",
  "sospechosos": [
    {
      "id": "s1",
      "nombre": "string",
      "perfil": "string",
      "coartada": "string"
    }
  ]
}`;
    }

    function buildPrompt1C(base, sospechosos, culpableId, dificultad) {
      const culpableObj = sospechosos.find(s => s.id === culpableId);
      const culpableNombre = culpableObj ? culpableObj.nombre : culpableId;

      return `Sos el autor de un juego de misterio policial. Generá las evidencias y declaraciones de testigos.

CONTEXTO DEL CASO:
- Título: ${base.titulo}
- Época: ${base.epoca}
- Crimen: ${base.tipo_crimen}
- Escena: ${base.descripcionEscena}
- Culpable real: ${culpableNombre}
- Arma/método: decidí vos cuál evidencia será el arma principal

REGLAS:
- ${dificultad === 'Fácil' ? '4 evidencias' : '5 evidencias'}
- El arma principal debe tener una ubicación coherente con la escena
- Las otras evidencias pueden señalar a inocentes o ser ambiguas
- Exactamente 2 testigos con declaraciones que aporten pistas reales pero incompletas
- Cada campo: máximo 2 oraciones

Devolvé ÚNICAMENTE este JSON sin texto extra ni markdown:

{
  "arma_id": "e1",
  "evidencias": [
    {
      "id": "e1",
      "objeto": "string",
      "descripcion": "string",
      "ubicacion": "string"
    }
  ],
  "declaraciones": [
    {
      "testigo": "string",
      "relacion": "string",
      "texto": "string"
    }
  ]
}`;
    }

    function buildPrompt1D(base, sospechosos, culpableId) {
      const listaSospechosos = sospechosos.map(s =>
        `- ${s.id}: ${s.nombre} | Perfil: ${s.perfil} | Coartada: ${s.coartada}`
      ).join('\n');

      return `Sos el autor de un juego de misterio policial. Generá exactamente 5 preguntas con respuestas para cada sospechoso.

CASO:
- Crimen: ${base.tipo_crimen} en ${base.epoca}
- Víctima: ${base.victima.nombre}
- Culpable real: ${culpableId}

SOSPECHOSOS:
${listaSospechosos}

REGLAS CRÍTICAS:
- 5 preguntas por sospechoso, sin excepción
- Para el culpable (${culpableId}): al menos 1 respuesta contiene una contradicción sutil o detalle que lo delata si se presta atención
- Para cada inocente: al menos 1 pregunta es un red herring que puede confundir
- Cada respuesta: máximo 2 oraciones, en primera persona del sospechoso
- Las preguntas deben ser coherentes con el perfil y la coartada de cada uno

Devolvé ÚNICAMENTE este JSON sin texto extra ni markdown.
Si hay 3 sospechosos el JSON tiene 3 claves, si hay 4 tiene 4 claves:

{
  "preguntas": {
    "s1": [
      { "id": "p1", "pregunta": "string", "respuesta": "string" },
      { "id": "p2", "pregunta": "string", "respuesta": "string" },
      { "id": "p3", "pregunta": "string", "respuesta": "string" },
      { "id": "p4", "pregunta": "string", "respuesta": "string" },
      { "id": "p5", "pregunta": "string", "respuesta": "string" }
    ]
  }
}`;
    }

    function buildPrompt1E(base, sospechosos, culpableId, evidencias, armaId, dificultad) {
      const listaEvidencias = evidencias.map(e =>
        `- ${e.id}: ${e.objeto} | Ubicación: ${e.ubicacion}`
      ).join('\n');

      const culpableObj = sospechosos.find(s => s.id === culpableId);
      const culpableNombre = culpableObj ? culpableObj.nombre : culpableId;
      const armaObj = evidencias.find(e => e.id === armaId);
      const armaNombre = armaObj ? armaObj.objeto : armaId;

      return `Sos el jefe del laboratorio forense. Generá el informe de análisis para cada evidencia.

CASO:
- Crimen: ${base.tipo_crimen} en ${base.epoca}
- Culpable: ${culpableNombre}
- Arma principal: ${armaNombre} (id: ${armaId})

EVIDENCIAS:
${listaEvidencias}

REGLAS:
- El análisis del arma principal (${armaId}) debe contener prueba forense concreta que vincule al culpable (huellas, ADN, fibras, etc.)
- Las otras evidencias: pueden ser neutras, ambiguas o señalar a inocentes
- Dificultad "${dificultad}": ${dificultad === 'Difícil' ? 'las pruebas son ambiguas excepto en el arma principal' : 'las pruebas son más directas'}
- Tono técnico/científico. Máximo 2 oraciones por evidencia.

Devolvé ÚNICAMENTE este JSON sin texto extra ni markdown:

{
  "forense": {
    "e1": "string",
    "e2": "string"
  }
}`;
    }

    function buildPrompt1F(base, sospechosos, culpableId, evidencias, armaId) {
      const culpableObj = sospechosos.find(s => s.id === culpableId);
      const culpableNombre = culpableObj ? culpableObj.nombre : culpableId;
      const armaObj = evidencias.find(e => e.id === armaId);
      const armaNombre = armaObj ? armaObj.objeto : armaId;

      const resumenCompleto = `
Título: ${base.titulo}
Época: ${base.epoca}
Víctima: ${base.victima.nombre}
Culpable: ${culpableNombre} (${culpableId})
Arma: ${armaNombre} (${armaId})
Sospechosos: ${sospechosos.map(s => s.nombre).join(', ')}
Evidencias: ${evidencias.map(e => e.objeto).join(', ')}
`;

      return `Sos el autor de un juego de misterio policial. Generá la verdad sellada del caso.

RESUMEN DEL CASO:
${resumenCompleto}

REGLAS:
- secuenciaReal: narración dramática de cómo ocurrió el crimen, coherente con TODO lo del caso. Máximo 4 oraciones.
- pistasClave: exactamente 3, referenciando elementos concretos del caso que el jugador debió notar
- movil: el motivo real del crimen. Máximo 2 oraciones.
- Las 4 condenas deben variar dramáticamente en tono y consecuencias

Devolvé ÚNICAMENTE este JSON sin texto extra ni markdown:

{
  "truth": {
    "culpable": "${culpableId}",
    "arma": "${armaId}",
    "movil": "string",
    "secuenciaReal": "string",
    "pistasClave": ["string", "string", "string"],
    "rubrica": {
      "acerto_culpable": 40,
      "acerto_movil": 20,
      "acerto_arma": 20,
      "calidad_reconstruccion_max": 20
    },
    "condenas": {
      "80_100": "string — cadena perpetua, tono definitivo",
      "50_79": "string — condena parcial, la defensa redujo la pena",
      "20_49": "string — condena mínima, casi sin consecuencias",
      "0_19": "string — absolución, el culpable queda libre"
    }
  }
}`;
    }

    /* ============================================================
       FLUJO DE GENERACIÓN — 6 LLAMADAS QUIRÚRGICAS (max_tokens: 4000)
       ============================================================ */
    function showGenerationError(msg) {
      const errBox = document.getElementById('caseGenErrorBox');
      const errTitle = document.getElementById('caseGenErrorTitle');
      const errMsg = document.getElementById('caseGenErrorMessage');

      if (errTitle) errTitle.textContent = "Error al generar el expediente";
      if (errMsg) errMsg.textContent = `Ocurrió una falla durante la generación: ${msg}. Puedes reintentar directamente.`;

      if (errBox) {
        errBox.style.display = 'block';
        errBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    async function generateCase(ciudad, dificultad) {
      // Validar API key
      const hasKey = (AppState.apiConfig.provider === 'custom') || (AppState.apiConfig.apiKey && AppState.apiConfig.apiKey.trim().length > 0);
      if (!hasKey) {
        alert("⚠️ ATENCIÓN: No has configurado tu API Key todavía.\n\nPara que la Inteligencia Artificial genere un expediente policial personalizado, debes ingresar tu clave. Te abrimos la ventana de configuración a continuación.");
        document.getElementById('settingsModal').classList.add('active');
        return;
      }

      const errBox = document.getElementById('caseGenErrorBox');
      if (errBox) errBox.style.display = 'none';

      const loadingBox = document.getElementById('loadingBox');
      const btnGen = document.getElementById('btnGenerateCase');

      loadingBox.style.display = 'block';
      btnGen.disabled = true;

      let base, sospechosoData, evidenciaData, preguntasData, forenseData, truthData;

      try {
        setProgress(1);
        const r1A = await makeLLMRequest(buildPrompt1A(ciudad, dificultad), 4000);
        base = parseLLMJson(r1A.text);
        if (!base.titulo || !base.victima || !base.descripcionEscena || !base.informeGeneral) {
          throw new Error("Paso 1 incompleto");
        }

        setProgress(2);
        const r1B = await makeLLMRequest(buildPrompt1B(base, dificultad), 4000);
        sospechosoData = parseLLMJson(r1B.text);
        if (!sospechosoData.sospechosos?.length || !sospechosoData.culpable_id) {
          throw new Error("Paso 2 incompleto");
        }
        const { culpable_id: culpableId, sospechosos } = sospechosoData;

        setProgress(3);
        const r1C = await makeLLMRequest(buildPrompt1C(base, sospechosos, culpableId, dificultad), 4000);
        evidenciaData = parseLLMJson(r1C.text);
        if (!evidenciaData.evidencias?.length || !evidenciaData.arma_id || !evidenciaData.declaraciones) {
          throw new Error("Paso 3 incompleto");
        }
        const { arma_id: armaId, evidencias, declaraciones } = evidenciaData;

        setProgress(4);
        const r1D = await makeLLMRequest(buildPrompt1D(base, sospechosos, culpableId), 4000);
        preguntasData = parseLLMJson(r1D.text);
        if (!preguntasData.preguntas) {
          throw new Error("Paso 4 incompleto");
        }

        setProgress(5);
        const r1E = await makeLLMRequest(buildPrompt1E(base, sospechosos, culpableId, evidencias, armaId, dificultad), 4000);
        forenseData = parseLLMJson(r1E.text);
        if (!forenseData.forense) {
          throw new Error("Paso 5 incompleto");
        }

        setProgress(6);
        const r1F = await makeLLMRequest(buildPrompt1F(base, sospechosos, culpableId, evidencias, armaId), 4000);
        truthData = parseLLMJson(r1F.text);
        if (!truthData.truth?.culpable) {
          throw new Error("Paso 6 incompleto");
        }

        // Barra al 100% y todos los pasos listos
        const bar = document.getElementById('progressBarFill');
        if (bar) bar.style.width = '100%';
        const label = document.getElementById('progressLabel');
        if (label) label.textContent = 'Expediente sellado y listo.';
        for (let i = 1; i <= 6; i++) {
          const stepEl = document.getElementById(`pStep${i}`);
          if (stepEl) {
            stepEl.classList.remove('active');
            stepEl.classList.add('done');
          }
        }

        // MERGE
        const publicInfo = {
          ...base,
          lugar: base.ciudad || base.epoca || ciudad || 'Desconocido',
          ciudad: base.ciudad || ciudad || 'Desconocido',
          fecha: base.epoca || base.fecha || 'Sin fecha',
          sospechosos: sospechosos.map(s => ({
            ...s,
            preguntas: (preguntasData.preguntas && preguntasData.preguntas[s.id]) || []
          })),
          evidencias: evidencias.map(e => ({
            ...e,
            analisisForense: (forenseData.forense && forenseData.forense[e.id]) || "Sin datos forenses."
          })),
          declaraciones: declaraciones || []
        };

        AppState.currentPublicInfo = publicInfo;
        AppState.currentTruth = truthData.truth;
        AppState.forensicsUsed = 0;
        AppState.interrogationsState = {};
        AppState.isOfflineMode = false;

        SafeStorage.setItem('caso_publicInfo', JSON.stringify(publicInfo));
        SafeStorage.setItem('caso_truth', obfuscateTruth(truthData.truth));

        renderInvestigationDossier();
        showScreen('screenInvestigation');

      } catch (err) {
        console.error("Error en generación del caso:", err);
        showGenerationError(err.message);
      } finally {
        loadingBox.style.display = 'none';
        btnGen.disabled = false;
      }
    }

    async function handleGenerateCase() {
      const ciudadInput = document.getElementById('inputCiudad').value.trim();
      const dificultad = document.getElementById('selectDificultad').value;
      await generateCase(ciudadInput, dificultad);
    }

    function loadDemoCase() {
      AppState.currentPublicInfo = JSON.parse(JSON.stringify(DEMO_CASE.publicInfo));
      AppState.currentTruth = JSON.parse(JSON.stringify(DEMO_CASE.truth));
      AppState.isOfflineMode = true;

      SafeStorage.setItem('caso_publicInfo', JSON.stringify(AppState.currentPublicInfo));
      SafeStorage.setItem('caso_truth', obfuscateTruth(AppState.currentTruth));

      renderInvestigationDossier();
      showScreen('screenInvestigation');
    }

    /* ============================================================
       RENDER INVESTIGATION DOSSIER
       ============================================================ */
    function renderInvestigationDossier() {
      const pub = AppState.currentPublicInfo;
      if (!pub) return;

      AppState.forensicsUsed = 0;
      AppState.interrogationsState = {};

      document.getElementById('btnRestartDossier').style.display = 'inline-flex';

      // Header Meta
      document.getElementById('displayTituloCaso').textContent = pub.titulo || "EXPEDIENTE CRIMINAL";
      document.getElementById('displayMetaCaso').textContent = `LUGAR: ${pub.lugar} | FECHA: ${pub.fecha}`;

      // Tab 1: Informe
      document.getElementById('displayVictimaNombre').textContent = pub.victima?.nombre || "Sin identificar";
      document.getElementById('displayVictimaDesc').textContent = pub.victima?.descripcion || "";
      document.getElementById('displayInformeGeneral').textContent = pub.informeGeneral || "";

      // Tab 2: Declaraciones
      const witCont = document.getElementById('witnessesContainer');
      witCont.innerHTML = '';
      (pub.declaraciones || []).forEach((w, idx) => {
        const card = document.createElement('div');
        card.className = 'witness-card';
        card.innerHTML = `
          <div class="witness-header">
            <div class="witness-name">
              <span>TESTIGO #${idx + 1}: ${escapeHtml(w.testigo)}</span>
              <span class="witness-badge">${escapeHtml(w.relacion)}</span>
            </div>
            <span style="font-size: 11px; color: #72624a; font-family: var(--font-typewriter);">ACTA TOMADA</span>
          </div>
          <div class="witness-text">"${escapeHtml(w.texto)}"</div>
        `;
        witCont.appendChild(card);
      });

      // Tab 3: Sospechosos (Mugshots)
      const suspCont = document.getElementById('suspectsContainer');
      suspCont.innerHTML = '';
      (pub.sospechosos || []).forEach((s, idx) => {
        const card = document.createElement('div');
        card.className = 'suspect-card';
        card.id = `card-suspect-${s.id}`;

        // Generate height measurement markings
        const heightMarks = `
          <div>6'0"</div>
          <div>5'9"</div>
          <div>5'6"</div>
          <div>5'3"</div>
          <div>5'0"</div>
        `;

        // Silhouette SVG with noir style
        const silhouetteSvg = `
          <svg viewBox="0 0 100 120" style="width: 90px; height: 110px; fill: #2c251c;">
            <circle cx="50" cy="35" r="22"/>
            <path d="M15 110 C 15 70, 85 70, 85 110 Z"/>
          </svg>
        `;

        card.innerHTML = `
          <div class="mugshot-frame">
            <div class="height-lines"></div>
            <div class="height-marks">${heightMarks}</div>
            <div class="mugshot-avatar">
              ${silhouetteSvg}
            </div>
            <div class="police-placard">
              POLICE DEPT // ID: ${s.id.toUpperCase()}
            </div>
          </div>
          <div class="suspect-info">
            <div class="suspect-name">${escapeHtml(s.nombre)}</div>
            <div class="suspect-profile">${escapeHtml(s.perfil)}</div>
            <div class="suspect-alibi">
              <strong>COARTADA DECLARADA:</strong> ${escapeHtml(s.coartada)}
            </div>
          </div>
          <div class="suspect-card-actions">
            <button class="btn-wood primary" style="width: 100%; justify-content: center;" onclick="openInterrogationModal('${s.id}')">
              🎙 Interrogar Sospechoso
            </button>
          </div>
        `;
        suspCont.appendChild(card);
      });

      // Tab 4: Escena
      document.getElementById('displayEscenaCrimen').textContent = pub.descripcionEscena || "";

      // Tab 5: Evidencias (Bolsas forenses)
      const eviCont = document.getElementById('evidencesContainer');
      eviCont.innerHTML = '';

      (pub.evidencias || []).forEach((e, idx) => {
        const bag = document.createElement('div');
        bag.className = 'evidence-bag';
        bag.id = `bag-${e.id}`;
        bag.innerHTML = `
          <div class="evidence-tag">
            <div class="tag-header">
              <span class="tag-title">DEPT. EVIDENCIAS // CADENA DE CUSTODIA</span>
              <span class="tag-barcode">||| | |||| | ||</span>
            </div>
            <div class="evidence-item-name">EVIDENCIA #${idx + 1}: ${escapeHtml(e.objeto)}</div>
            <div class="evidence-desc">${escapeHtml(e.descripcion)}</div>
            <div class="evidence-location"><strong>HALLADA EN:</strong> ${escapeHtml(e.ubicacion)}</div>

            <div id="forensicSection-${e.id}">
              <button class="btn-wood forensic-btn" id="btnForensic-${e.id}" style="font-size: 11px; padding: 7px 12px; width: 100%; justify-content: center;" onclick="requestForensicAnalysis('${e.id}')">
                🔬 Solicitar análisis forense (Disponibles: 2 / 2)
              </button>
            </div>
          </div>
        `;
        eviCont.appendChild(bag);
      });
      updateForensicUI();

      // Tab 6: Acusación Selects
      const selAcusado = document.getElementById('selectAcusado');
      selAcusado.innerHTML = '<option value="">-- Seleccionar al culpable --</option>';
      (pub.sospechosos || []).forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = `${s.nombre} (${s.id.toUpperCase()})`;
        selAcusado.appendChild(opt);
      });

      const selArma = document.getElementById('selectArma');
      selArma.innerHTML = '<option value="">-- Seleccionar evidencia homicida --</option>';
      (pub.evidencias || []).forEach(e => {
        const opt = document.createElement('option');
        opt.value = e.id;
        opt.textContent = `${e.objeto} (${e.id.toUpperCase()})`;
        selArma.appendChild(opt);
      });

      document.getElementById('textMotivo').value = '';
      document.getElementById('textReconstruccion').value = '';
      document.getElementById('verdictLoadingBox').style.display = 'none';
      document.getElementById('btnSubmitVerdict').disabled = false;

      // Start on tab 1
      switchTab('tabInforme');
    }

    /* ============================================================
       FORENSIC ANALYSIS (MAX 2)
       ============================================================ */
    function updateForensicUI() {
      const left = Math.max(0, 2 - AppState.forensicsUsed);
      const countBadge = document.getElementById('forensicCountBadge');
      if (countBadge) {
        countBadge.textContent = `${left} / 2`;
      }

      document.querySelectorAll('.forensic-btn').forEach(btn => {
        if (left <= 0) {
          btn.disabled = true;
          btn.innerHTML = `🚫 Cupo forense agotado (0 / 2 disponibles)`;
          btn.style.opacity = '0.6';
          btn.style.cursor = 'not-allowed';
        } else {
          btn.disabled = false;
          btn.innerHTML = `🔬 Solicitar análisis forense (Disponibles: ${left} / 2)`;
          btn.style.opacity = '1';
          btn.style.cursor = 'pointer';
        }
      });
    }

    window.requestForensicAnalysis = function(evidenceId) {
      if (AppState.forensicsUsed >= 2) {
        alert("Atención: Ya has utilizado el límite máximo de 2 análisis de laboratorio para este caso.");
        return;
      }

      const pub = AppState.currentPublicInfo;
      const evi = (pub.evidencias || []).find(e => e.id === evidenceId);
      if (!evi) return;

      AppState.forensicsUsed++;
      const targetDiv = document.getElementById(`forensicSection-${evidenceId}`);
      if (targetDiv) {
        targetDiv.innerHTML = `
          <div class="forensic-result">
            <strong>DICTAMEN DEL LABORATORIO FORENSE:</strong>
            ${escapeHtml(evi.analisisForense)}
          </div>
        `;
      }
      updateForensicUI();
    };

    /* ============================================================
       INTERROGATION MODAL (EXACTLY 3 QUESTIONS)
       ============================================================ */
    let currentInterrogatingSuspectId = null;
    let selectedQuestionIds = new Set();

    window.openInterrogationModal = function(suspectId) {
      currentInterrogatingSuspectId = suspectId;
      selectedQuestionIds.clear();

      const pub = AppState.currentPublicInfo;
      const susp = (pub.sospechosos || []).find(s => s.id === suspectId);
      if (!susp) return;

      document.getElementById('intModalSuspectName').textContent = `Interrogatorio: ${susp.nombre}`;
      const qList = document.getElementById('intQuestionsList');
      qList.innerHTML = '';

      const isAlreadyDone = AppState.interrogationsState[suspectId];

      if (isAlreadyDone) {
        // Show already interrogated questions
        document.getElementById('intInstructionsBox').innerHTML = `
          <strong>INTERROGATORIO CERRADO:</strong> Las 3 preguntas seleccionadas ya fueron formuladas. Las 2 restantes fueron clasificadas por el defensor.
        `;
        document.getElementById('intSelectedCount').textContent = '3 / 3 (Completado)';
        document.getElementById('btnConfirmInterrogation').style.display = 'none';

        susp.preguntas.forEach(q => {
          const wasAnswered = isAlreadyDone.answeredQuestions.includes(q.id);
          const item = document.createElement('div');
          item.className = 'question-item answered';
          item.innerHTML = `
            <div class="question-label-row">
              <span style="font-weight: 700; color: ${wasAnswered ? '#1e6e2f' : '#8b1e1e'};">
                ${wasAnswered ? '✓ FORMULADA' : '✗ CLASIFICADA / SELLADA'}
              </span>
              <div class="question-text">${escapeHtml(q.pregunta)}</div>
            </div>
            <div class="answer-box ${wasAnswered ? '' : 'redacted'}">
              ${wasAnswered ? `<strong>RESPUESTA:</strong> "${escapeHtml(q.respuesta)}"` : '<em>[El sospechoso se acogió a su derecho al silencio / Pregunta no formulada]</em>'}
            </div>
          `;
          qList.appendChild(item);
        });

      } else {
        // Active interrogation: choose exactly 3
        document.getElementById('intInstructionsBox').innerHTML = `
          <strong>REGLA DE INTERROGATORIO:</strong> Tienes permitido formular <strong>exactamente 3 preguntas</strong> antes de que el abogado defensor interrumpa la declaración. Elige con máxima prudencia; las otras 2 preguntas quedarán selladas.
        `;
        document.getElementById('intSelectedCount').textContent = '0 / 3';
        const confirmBtn = document.getElementById('btnConfirmInterrogation');
        confirmBtn.style.display = 'inline-flex';
        confirmBtn.disabled = true;

        susp.preguntas.forEach(q => {
          const item = document.createElement('div');
          item.className = 'question-item';
          item.id = `qItem-${q.id}`;
          item.innerHTML = `
            <div class="question-label-row">
              <input type="checkbox" class="question-checkbox" id="chk-${q.id}" data-qid="${q.id}">
              <label for="chk-${q.id}" class="question-text" style="cursor: pointer;">${escapeHtml(q.pregunta)}</label>
            </div>
          `;

          item.addEventListener('click', (e) => {
            if (e.target.tagName !== 'INPUT') {
              const chk = item.querySelector('input');
              chk.checked = !chk.checked;
            }
            toggleQuestionSelect(q.id);
          });

          qList.appendChild(item);
        });
      }

      document.getElementById('interrogationModal').classList.add('active');
    };

    function toggleQuestionSelect(qId) {
      const chk = document.getElementById(`chk-${qId}`);
      const item = document.getElementById(`qItem-${qId}`);

      if (chk.checked) {
        if (selectedQuestionIds.size >= 3) {
          chk.checked = false;
          alert("Ya has seleccionado las 3 preguntas permitidas.");
          return;
        }
        selectedQuestionIds.add(qId);
        item.classList.add('selected');
      } else {
        selectedQuestionIds.delete(qId);
        item.classList.remove('selected');
      }

      const count = selectedQuestionIds.size;
      document.getElementById('intSelectedCount').textContent = `${count} / 3`;
      document.getElementById('btnConfirmInterrogation').disabled = (count !== 3);
    }

    function confirmInterrogation() {
      if (selectedQuestionIds.size !== 3) return;

      const suspectId = currentInterrogatingSuspectId;
      AppState.interrogationsState[suspectId] = {
        answeredQuestions: Array.from(selectedQuestionIds)
      };

      // Add visual stamp to card on suspects tab
      const card = document.getElementById(`card-suspect-${suspectId}`);
      if (card && !card.querySelector('.stamp-interrogated')) {
        const stamp = document.createElement('div');
        stamp.className = 'stamp-interrogated';
        stamp.textContent = 'INTERROGADO';
        card.appendChild(stamp);
      }

      // Re-render modal to show answers
      window.openInterrogationModal(suspectId);
    }

    /* ============================================================
       VERDICT EVALUATION (LLAMADA 2)
       ============================================================ */
    async function handleSubmitVerdict() {
      const acusadoId = document.getElementById('selectAcusado').value;
      const armaId = document.getElementById('selectArma').value;
      const motivo = document.getElementById('textMotivo').value.trim();
      const reconstruccion = document.getElementById('textReconstruccion').value.trim();

      if (!acusadoId || !armaId || !motivo || !reconstruccion) {
        alert("Por favor completa todos los campos de la acusación (Sospechoso, Arma, Móvil y Reconstrucción).");
        return;
      }

      const pub = AppState.currentPublicInfo;
      const tru = AppState.currentTruth;
      const susp = (pub.sospechosos || []).find(s => s.id === acusadoId);
      const arma = (pub.evidencias || []).find(e => e.id === armaId);

      const loadingBox = document.getElementById('verdictLoadingBox');
      const submitBtn = document.getElementById('btnSubmitVerdict');
      loadingBox.style.display = 'block';
      submitBtn.disabled = true;

      // Check if we can use LLM or fallback to local evaluator
      const canCallLLM = !AppState.isOfflineMode && (AppState.apiConfig.apiKey || AppState.apiConfig.provider === 'custom');

      if (canCallLLM) {
        const promptCall2 = `Sos el juez evaluador de un juego de misterio policial.

SOLUCIÓN REAL DEL CASO:
${JSON.stringify(tru, null, 2)}

DEDUCCIÓN DEL JUGADOR:
- Acusado: ${susp?.nombre} (ID: ${acusadoId})
- Arma/método: ${arma?.objeto} (ID: ${armaId})
- Motivo propuesto: ${motivo}
- Reconstrucción: ${reconstruccion}

INSTRUCCIONES:
- Evaluá si el jugador acertó el culpable (40 pts), el arma (20 pts) y el motivo (20 pts) comparando con la solución real.
- Para la calidad de la reconstrucción (0 a 20 puntos): evaluá coherencia lógica, uso de las pistas disponibles y si la narrativa se aproxima a la secuencia real aunque no sea perfecta.
- Escribí 'narrativaCondena' como un párrafo dramatizado estilo periodístico/judicial que cuente cómo terminó el caso según el puntaje obtenido.
- Usá el texto de condena del rango correspondiente al puntajeTotal (0-19, 20-49, 50-79, 80-100).

Devolvé ÚNICAMENTE el JSON de resultado con esta estructura exacta. Sin explicaciones ni texto adicional:
{
  "puntaje": 0,
  "desglose": {
    "culpable": { "acerto": true, "puntos": 40 },
    "movil": { "acerto": false, "puntos": 0 },
    "arma": { "acerto": true, "puntos": 20 },
    "reconstruccion": { "puntos": 12, "comentario": "string" }
  },
  "puntajeTotal": 72,
  "condena": "string con el texto de la condena",
  "narrativaCondena": "string"
}`;

        try {
          const resp = await makeLLMRequest(promptCall2, 1500, (attempt, maxAttempts, delayMs) => {
            const vTeletype = document.querySelector('#verdictLoadingBox .teletype-text');
            if (vTeletype) {
              vTeletype.textContent = `EL TRIBUNAL EXPERIMENTA ALTA DEMANDA. REINTENTANDO AUTOMÁTICAMENTE [${attempt}/${maxAttempts}] EN ${delayMs/1000}s...`;
            }
          });
          const evalResult = parseLLMJson(resp.text);
          renderVerdictResults(evalResult);
          return;
        } catch (err) {
          console.warn("LLM verdict failed, evaluating locally:", err);
        } finally {
          loadingBox.style.display = 'none';
          submitBtn.disabled = false;
        }
      }

      // Local Deterministic Evaluator (for offline mode or fallback)
      setTimeout(() => {
        const acertoCulpable = (acusadoId === tru.culpable);
        const acertoArma = (armaId === tru.arma);

        // Simple fuzzy check for motive words
        const truthMotiveKeywords = tru.movil.toLowerCase().split(/\s+/).filter(w => w.length > 4);
        const userMotiveWords = motivo.toLowerCase();
        let matchCount = 0;
        truthMotiveKeywords.forEach(k => {
          if (userMotiveWords.includes(k)) matchCount++;
        });
        const acertoMovil = acertoCulpable && (matchCount >= 2 || userMotiveWords.length > 30);

        // Score reconstruction quality based on depth and clues mentioned
        let reconPoints = Math.min(20, Math.max(5, Math.floor(reconstruccion.length / 25)));
        if (!acertoCulpable) reconPoints = Math.min(6, reconPoints);

        const ptsCulpable = acertoCulpable ? 40 : 0;
        const ptsArma = acertoArma ? 20 : 0;
        const ptsMovil = acertoMovil ? 20 : 0;
        const puntajeTotal = ptsCulpable + ptsArma + ptsMovil + reconPoints;

        let condenaKey = "0_19";
        if (puntajeTotal >= 80) condenaKey = "80_100";
        else if (puntajeTotal >= 50) condenaKey = "50_79";
        else if (puntajeTotal >= 20) condenaKey = "20_49";

        const condenaTexto = tru.condenas?.[condenaKey] || "Resolución judicial sumaria.";

        const localResult = {
          puntajeTotal: puntajeTotal,
          desglose: {
            culpable: { acerto: acertoCulpable, puntos: ptsCulpable },
            arma: { acerto: acertoArma, puntos: ptsArma },
            movil: { acerto: acertoMovil, puntos: ptsMovil },
            reconstruccion: {
              puntos: reconPoints,
              comentario: acertoCulpable 
                ? "El relato capturó con solidez los indicios clave y la mecánica criminal." 
                : "La reconstrucción desvió su atención hacia un sospechoso inocente a pesar de los indicios materiales."
            }
          },
          condena: condenaTexto,
          narrativaCondena: acertoCulpable
            ? `El tribunal dio por plenamente probada la autoría de los hechos. La solidez de las evidencias incautadas no dejó margen de duda para el jurado en su sentencia definitiva.`
            : `El acusado fue puesto en libertad bajo fianza y las pruebas resultaron insuficientes para sostener una acusación formal. El sumario fue devuelto a los archivos policiales como no resuelto.`
        };

        loadingBox.style.display = 'none';
        submitBtn.disabled = false;
        renderVerdictResults(localResult);
      }, 900);
    }

    /* ============================================================
       RENDER VERDICT RESULTS (SCREEN 4)
       ============================================================ */
    function renderVerdictResults(res) {
      const tru = AppState.currentTruth;
      const des = res.desglose || {};

      // Score
      const total = res.puntajeTotal !== undefined ? res.puntajeTotal : (res.puntaje || 0);
      document.getElementById('vTotalScore').textContent = `${total} / 100`;

      // Badges
      const setBadge = (elementId, acerto, pts) => {
        const el = document.getElementById(elementId);
        if (acerto) {
          el.className = 'breakdown-status hit';
          el.textContent = `✓ ACERTADO (+${pts} pts)`;
        } else {
          el.className = 'breakdown-status miss';
          el.textContent = `✗ FALLIDO (0 pts)`;
        }
      };

      setBadge('vBadgeCulpable', des.culpable?.acerto, des.culpable?.puntos || 40);
      setBadge('vBadgeArma', des.arma?.acerto, des.arma?.puntos || 20);
      setBadge('vBadgeMovil', des.movil?.acerto, des.movil?.puntos || 20);

      const rPoints = des.reconstruccion?.puntos || 0;
      const recBadge = document.getElementById('vBadgeReconstruccion');
      recBadge.className = rPoints >= 10 ? 'breakdown-status hit' : 'breakdown-status miss';
      recBadge.textContent = `+${rPoints} / 20 pts`;

      document.getElementById('vComentarioReconstruccion').textContent = 
        des.reconstruccion?.comentario || "Sin observaciones adicionales.";

      // Step 2: La verdad
      document.getElementById('vSecuenciaReal').textContent = tru.secuenciaReal || "";

      const cluesList = document.getElementById('vPistasClaveList');
      cluesList.innerHTML = '';
      (tru.pistasClave || []).forEach(clue => {
        const item = document.createElement('div');
        item.className = 'clue-item';
        item.textContent = `📌 ${clue}`;
        cluesList.appendChild(item);
      });

      // Step 3: Condena
      document.getElementById('vCondenaTitulo').textContent = res.condena || "SENTENCIA SUMARIA";
      document.getElementById('vNarrativaCondena').textContent = res.narrativaCondena || "";

      switchVerdictStep(1);
      showScreen('screenVerdict');
    }

    /* Helper: Escape HTML string */
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Run on startup
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
