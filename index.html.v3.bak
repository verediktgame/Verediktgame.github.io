    const AppState = {
      apiConfig: {
        provider: 'openai',
        apiKey: '',
        endpoint: 'https://api.openai.com/v1/chat/completions',
        model: 'gpt-4o'
      },
      currentPublicInfo: null,
      currentTruth: null,
      forensicsUsed: 0,
      interrogationsState: {}, // suspectId: { answeredQuestions: [pId, pId, pId] }
      isOfflineMode: false
    };

    /* Provider Endpoint Defaults */
    const PROVIDER_DEFAULTS = {
      openai: {
        endpoint: 'https://api.openai.com/v1/chat/completions',
        model: 'gpt-4o'
      },
      gemini: {
