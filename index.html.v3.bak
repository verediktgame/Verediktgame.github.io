          <!-- TAB 6: ACUSACIÓN -->
          <div id="tabAcusacion" class="tab-panel">
            <div class="accusation-form-card">
              <div class="accusation-stamp">
                <span class="stamp">RESOLUCIÓN FINAL</span>
