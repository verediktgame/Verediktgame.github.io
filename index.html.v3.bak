              <span class="stamp">SUMARIO ABIERTO</span>
            </div>
          </div>

          <!-- TAB 1: INFORME GENERAL -->
          <div id="tabInforme" class="tab-panel active">
            <div class="report-grid">
              <div class="victim-card">
                <div class="victim-silhouette">
                  <!-- Silhouette SVG -->
                  <svg viewBox="0 0 24 24">
                    <path d="M12 2C9.243 2 7 4.243 7 7c0 2.134 1.344 3.953 3.23 4.655C6.442 12.637 4 15.932 4 20h16c0-4.068-2.442-7.363-6.23-8.345C15.656 10.953 17 9.134 17 7c0-2.757-2.243-5-5-5z"/>
                  </svg>
                </div>
                <div class="victim-meta">
                  <div><strong>VÍCTIMA:</strong> <span id="displayVictimaNombre">-</span></div>
                  <div style="margin-top: 8px;"><strong>DESCRIPCIÓN / ANTECEDENTES:</strong></div>
                  <div id="displayVictimaDesc" style="color: #4a3c2a; margin-top: 4px;">-</div>
                </div>
              </div>

              <div>
                <div class="official-report-text" id="displayInformeGeneral">
                  Cargando sumario oficial...
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 2: DECLARACIONES -->
          <div id="tabDeclaraciones" class="tab-panel">
            <div class="witness-list" id="witnessesContainer">
              <!-- Rendered dynamically -->
            </div>
          </div>

          <!-- TAB 3: SOSPECHOSOS -->
          <div id="tabSospechosos" class="tab-panel">
            <div class="suspects-grid" id="suspectsContainer">
