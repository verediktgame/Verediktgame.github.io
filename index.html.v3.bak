              <div class="breakdown-title">Móvil del Asesinato (+20)</div>
              <div class="breakdown-status" id="vBadgeMovil">--</div>
            </div>
            <div class="breakdown-card">
              <div class="breakdown-title">Calidad de Reconstrucción (+20)</div>
              <div class="breakdown-status" id="vBadgeReconstruccion">--</div>
            </div>
          </div>

          <div class="verdict-quote-box">
            <div style="font-size: 11px; font-weight: 700; color: #8b1e1e; letter-spacing: 2px; margin-bottom: 6px;">
              DICTAMEN SOBRE TU RECONSTRUCCIÓN:
            </div>
            <p id="vComentarioReconstruccion">-</p>
          </div>

          <div class="verdict-step-nav">
            <div></div>
            <button class="btn-wood primary" id="btnGoStep2">
              Paso 2: Cómo Ocurrió Realmente ➔
            </button>
          </div>
        </div>

        <!-- PASO 2: CÓMO OCURRIÓ REALMENTE -->
        <div id="verdictStep2" class="verdict-step">
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #8b1e1e; padding-bottom: 12px; margin-bottom: 24px;">
            <h2 style="font-family: var(--font-title); font-size: 24px; color: #1a140d;">PASO 2: LA VERDAD OCULTA</h2>
            <span class="stamp blue">REVELADO</span>
          </div>

          <div class="real-sequence-text" id="vSecuenciaReal">
            Cargando la verdad de los hechos...
          </div>

          <h3 style="font-family: var(--font-title); font-size: 16px; color: #1c2a38; margin-bottom: 12px; letter-spacing: 1.5px;">
            PISTAS CLAVE QUE DEBISTE HABER NOTADO:
          </h3>
          <div class="clues-list" id="vPistasClaveList">
            <!-- Rendered dynamically -->
          </div>

          <div class="verdict-step-nav">
            <button class="btn-wood" id="btnBackStep1">⬅ Volver al Puntaje</button>
            <button class="btn-wood primary" id="btnGoStep3">
              Paso 3: Sentencia y Condena ➔
            </button>
          </div>
        </div>

        <!-- PASO 3: LA CONDENA -->
        <div id="verdictStep3" class="verdict-step">
          <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #8b1e1e; padding-bottom: 12px; margin-bottom: 24px;">
            <h2 style="font-family: var(--font-title); font-size: 24px; color: #1a140d;">PASO 3: SENTENCIA JUDICIAL</h2>
            <span class="stamp">FALLO DEFINITIVO</span>
          </div>

          <div class="sentence-container">
            <div class="sentence-headline" id="vCondenaTitulo">CADENA PERPETUA</div>
            <div class="sentence-narrative" id="vNarrativaCondena">
              El tribunal de primera instancia resolvió el sumario tras analizar las evidencias presentadas.
            </div>
          </div>

          <div class="verdict-step-nav">
            <button class="btn-wood" id="btnBackStep2">⬅ Volver a los Hechos</button>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <button class="btn-wood secondary" id="btnExportCase" onclick="exportCase()">
                ↓ Exportar Caso (.json)
              </button>
              <button class="btn-wood primary" id="btnPlayAgain">
                ⎌ Investigar un Nuevo Caso
              </button>
            </div>
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- ============================================================
       MODAL: INTERROGAR SOSPECHOSO (3 PREGUNTAS EXACTAS)
       ============================================================ -->
  <div class="modal-backdrop" id="interrogationModal">
