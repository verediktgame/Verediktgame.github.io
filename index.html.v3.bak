            </div>
          </div>

          <!-- TAB 4: ESCENA DEL CRIMEN -->
          <div id="tabEscena" class="tab-panel">
            <div class="scene-container">
              <div class="scene-chalk-badge">
                <span>☠ REPORTE TÉCNICO DE ESCENA DEL CRIMEN</span>
              </div>
              <div class="scene-text" id="displayEscenaCrimen">
                Cargando descripción pericial del lugar de los hechos...
              </div>
            </div>
          </div>

          <!-- TAB 5: EVIDENCIAS FORENSES -->
          <div id="tabEvidencias" class="tab-panel">
            <div class="evidences-toolbar">
