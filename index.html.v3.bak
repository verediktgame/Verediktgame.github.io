    /* ============================================================
       OBFUSCATION / ENCRYPTION HELPERS FOR TRUTH
       ============================================================ */
    function obfuscateTruth(truthObj) {
      if (!truthObj) return '';
      try {
        const jsonStr = JSON.stringify(truthObj);
        // Base64 with UTF-8 support
        return btoa(encodeURIComponent(jsonStr).replace(/%([0-9A-F]{2})/g, (match, p1) => {
          return String.fromCharCode('0x' + p1);
        }));
      } catch (err) {
        console.warn("Obfuscation error, falling back to JSON:", err);
        return JSON.stringify(truthObj);
      }
    }

    function deobfuscateTruth(encodedStr) {
      if (!encodedStr) return null;
      try {
        // Decode base64 UTF-8
        const decoded = decodeURIComponent(atob(encodedStr).split('').map(c => {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
        return JSON.parse(decoded);
      } catch (e) {
        // Fallback if stored as plain JSON in older sessions
        try {
          return JSON.parse(encodedStr);
        } catch (err2) {
          console.error("Error decoding truth:", err2);
          return null;
        }
      }
    }

    /* ============================================================
       INITIALIZATION
       ============================================================ */
    function initApp() {
      loadSavedConfig();
      setupEventListeners();
      checkActiveCaseInStorage();
    }

    function loadSavedConfig() {
      const saved = SafeStorage.getItem('caso_apiConfig');
      if (saved) {
        try {
          AppState.apiConfig = Object.assign({}, AppState.apiConfig, JSON.parse(saved));
        } catch (e) {
          console.error("Error reading saved API config:", e);
        }
      }
      // Populate settings form
      document.getElementById('cfgProvider').value = AppState.apiConfig.provider;
      document.getElementById('cfgApiKey').value = AppState.apiConfig.apiKey;
      document.getElementById('cfgEndpoint').value = AppState.apiConfig.endpoint;
      document.getElementById('cfgModel').value = AppState.apiConfig.model;
    }

    function checkActiveCaseInStorage() {
      const pub = SafeStorage.getItem('caso_publicInfo');
      const tru = SafeStorage.getItem('caso_truth');
      if (pub && tru) {
        try {
          AppState.currentPublicInfo = JSON.parse(pub);
          AppState.currentTruth = deobfuscateTruth(tru);
          document.getElementById('btnRestartDossier').style.display = 'inline-flex';
        } catch(e) {}
      }
    }

    /* ============================================================
       EVENT LISTENERS
       ============================================================ */
    function setupEventListeners() {
      // Menu Navigation
      document.getElementById('btnStartNewCase').addEventListener('click', () => {
        showScreen('screenSetup');
      });

      document.getElementById('btnPlayDemoCase').addEventListener('click', () => {
        loadDemoCase();
      });

      document.getElementById('btnCancelSetup').addEventListener('click', () => {
        showScreen('screenMenu');
      });

      document.getElementById('btnRestartDossier').addEventListener('click', () => {
        if (AppState.currentPublicInfo) {
          renderInvestigationDossier();
          showScreen('screenInvestigation');
        }
      });

      // Settings Modal
      const openSettings = () => {
        document.getElementById('settingsModal').classList.add('active');
        document.getElementById('testResultBanner').className = 'test-result-banner';
        document.getElementById('testResultBanner').textContent = '';
      };
      document.getElementById('btnOpenSettings').addEventListener('click', openSettings);
      document.getElementById('btnMenuSettings').addEventListener('click', openSettings);

      document.getElementById('btnCloseSettings').addEventListener('click', () => {
        document.getElementById('settingsModal').classList.remove('active');
      });

      document.getElementById('cfgProvider').addEventListener('change', (e) => {
        const prov = e.target.value;
        if (PROVIDER_DEFAULTS[prov]) {
          document.getElementById('cfgEndpoint').value = PROVIDER_DEFAULTS[prov].endpoint;
          document.getElementById('cfgModel').value = PROVIDER_DEFAULTS[prov].model;
        }
      });

      document.getElementById('btnSaveSettings').addEventListener('click', saveSettingsFromForm);
      document.getElementById('btnTestConnection').addEventListener('click', testApiConnection);

      // Generate Case (Call 1)
      document.getElementById('btnGenerateCase').addEventListener('click', handleGenerateCase);
      document.getElementById('btnRetryGenerateCase').addEventListener('click', () => {
        const errBox = document.getElementById('caseGenErrorBox');
        if (errBox) errBox.style.display = 'none';
        handleGenerateCase();
      });
      document.getElementById('btnUseDemoFromError').addEventListener('click', () => {
        const errBox = document.getElementById('caseGenErrorBox');
        if (errBox) errBox.style.display = 'none';
        loadDemoCase();
      });

      // Investigation Dossier Tabs
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const targetTabId = e.currentTarget.getAttribute('data-tab');
          switchTab(targetTabId);
        });
      });

      // Interrogation Modal
      document.getElementById('btnCloseIntModal').addEventListener('click', () => {
        document.getElementById('interrogationModal').classList.remove('active');
      });

      document.getElementById('btnConfirmInterrogation').addEventListener('click', confirmInterrogation);

      // Submit Verdict (Call 2)
      document.getElementById('btnSubmitVerdict').addEventListener('click', handleSubmitVerdict);

      // Verdict 3-Step Navigation
      document.getElementById('btnGoStep2').addEventListener('click', () => switchVerdictStep(2));
      document.getElementById('btnBackStep1').addEventListener('click', () => switchVerdictStep(1));
      document.getElementById('btnGoStep3').addEventListener('click', () => switchVerdictStep(3));
      document.getElementById('btnBackStep2').addEventListener('click', () => switchVerdictStep(2));
      document.getElementById('btnPlayAgain').addEventListener('click', () => {
        showScreen('screenMenu');
      });

      // Import / Export
      document.getElementById('btnImportCase').addEventListener('click', () => {
        document.getElementById('importFileInput').click();
      });
      document.getElementById('importFileInput').addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) importCase(file);
        e.target.value = ''; // Reset for re-import
      });
      document.getElementById('btnExportCase').addEventListener('click', exportCase);

      // City Autocomplete
      setupCityAutocomplete();
    }

    function showScreen(screenId) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      const sc = document.getElementById(screenId);
      if (sc) sc.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      
      const btn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
      const panel = document.getElementById(tabId);
      if (btn) btn.classList.add('active');
      if (panel) panel.classList.add('active');
    }

    function switchVerdictStep(stepNumber) {
      document.querySelectorAll('.verdict-step').forEach(s => s.classList.remove('active'));
      const target = document.getElementById(`verdictStep${stepNumber}`);
      if (target) target.classList.add('active');
    }

    /* ============================================================
       SETTINGS MANAGEMENT
       ============================================================ */
    function saveSettingsFromForm() {
      AppState.apiConfig = {
        provider: document.getElementById('cfgProvider').value,
        apiKey: document.getElementById('cfgApiKey').value.trim(),
        endpoint: document.getElementById('cfgEndpoint').value.trim(),
        model: document.getElementById('cfgModel').value.trim()
      };
      SafeStorage.setItem('caso_apiConfig', JSON.stringify(AppState.apiConfig));
      document.getElementById('settingsModal').classList.remove('active');
      alert('✓ Configuración guardada en tu navegador.');
    }

    /* ============================================================
       LLM API CALL CLIENT (CON REINTENTOS ANTE ALTA DEMANDA)
       ============================================================ */
    async function executeSingleLLMRequest(prompt, maxTokens = 8192) {
      const { provider, apiKey, endpoint, model } = AppState.apiConfig;
      if (!apiKey && provider !== 'custom') {
        throw new Error("No se ha configurado ninguna API Key. Configúrala en el menú o utiliza el 'Caso Modelo (Offline)'.");
      }

      let response;
      const startTime = performance.now();

      if (provider === 'gemini') {
        // Google Gemini generateContent format
        const geminiUrl = `${endpoint.replace(/\/models\/.*:/, `/models/${model}:`)}?key=${apiKey}`;
        const payload = {
          contents: [{
            parts: [{ text: prompt }]
          }],
          generationConfig: {
            temperature: 0.3,
            maxOutputTokens: maxTokens,
            responseMimeType: "application/json"
          }
        };

        response = await fetch(geminiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errText = await response.text();
          throw new Error(`Gemini Error (${response.status}): ${errText}`);
        }

        const data = await response.json();
        const text = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
        return { text, latency: Math.round(performance.now() - startTime) };

      } else if (provider === 'anthropic') {
        // Anthropic Messages format
        const payload = {
          model: model,
          max_tokens: maxTokens,
          messages: [{ role: 'user', content: prompt }]
        };

        response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-api-key': apiKey,
            'anthropic-version': '2023-06-01',
            'dangerously-allow-browser': 'true'
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errText = await response.text();
          throw new Error(`Anthropic Error (${response.status}): ${errText}`);
        }

        const data = await response.json();
        const text = data?.content?.[0]?.text || '';
        return { text, latency: Math.round(performance.now() - startTime) };

      } else {
        // OpenAI / DeepSeek / Custom (Compatible /v1/chat/completions)
        const payload = {
          model: model,
          messages: [
            { role: 'system', content: 'Sos un narrador e inspector forense de misterios policiales noir. Responde exclusivamente con el JSON solicitado.' },
            { role: 'user', content: prompt }
          ],
          temperature: 0.4,
          max_tokens: maxTokens
        };

        const headers = {
          'Content-Type': 'application/json'
        };
        if (apiKey) {
          headers['Authorization'] = `Bearer ${apiKey}`;
        }

        response = await fetch(endpoint, {
          method: 'POST',
          headers: headers,
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          const errText = await response.text();
          throw new Error(`API Error (${response.status}): ${errText}`);
        }

        const data = await response.json();
        const text = data?.choices?.[0]?.message?.content || '';
        return { text, latency: Math.round(performance.now() - startTime) };
      }
    }

    async function makeLLMRequest(prompt, maxTokens = 8192, onRetry = null) {
      const maxRetries = 3;
      let lastError = null;

      for (let attempt = 1; attempt <= maxRetries; attempt++) {
        try {
          return await executeSingleLLMRequest(prompt, maxTokens);
        } catch (err) {
          lastError = err;
          const errMsg = (err.message || '').toLowerCase();
          const isHighDemand = 
            errMsg.includes('429') || 
            errMsg.includes('503') || 
            errMsg.includes('502') || 
            errMsg.includes('504') || 
            errMsg.includes('500') ||
            errMsg.includes('rate limit') ||
            errMsg.includes('overloaded') ||
            errMsg.includes('high demand') ||
            errMsg.includes('capacity') ||
            errMsg.includes('quota') ||
            errMsg.includes('busy') ||
            errMsg.includes('resource exhausted') ||
            errMsg.includes('temporarily unavailable');

          if (attempt < maxRetries && isHighDemand) {
            const delayMs = attempt * 2500;
            if (onRetry) {
              onRetry(attempt, maxRetries, delayMs, err);
            }
            await new Promise(resolve => setTimeout(resolve, delayMs));
            continue;
          } else {
            throw err;
          }
        }
      }
      throw lastError;
    }

    /* Test Connection Function */
    async function testApiConnection() {
      const banner = document.getElementById('testResultBanner');
      banner.className = 'test-result-banner';
      banner.textContent = 'Enviando pulso de prueba de 1 token...';
      banner.style.display = 'block';

      // Temporarily use values in the input boxes
      const origCfg = Object.assign({}, AppState.apiConfig);
      AppState.apiConfig = {
        provider: document.getElementById('cfgProvider').value,
        apiKey: document.getElementById('cfgApiKey').value.trim(),
        endpoint: document.getElementById('cfgEndpoint').value.trim(),
        model: document.getElementById('cfgModel').value.trim()
      };

      try {
        const res = await makeLLMRequest("Responde únicamente 'OK'", 10);
        banner.className = 'test-result-banner success';
        banner.textContent = `✓ Conexión exitosa. Latencia: ${res.latency}ms | Modelo: ${AppState.apiConfig.model} | Respuesta: ${res.text.trim().substring(0, 30)}`;
      } catch (err) {
        banner.className = 'test-result-banner error';
        banner.textContent = `✗ Error de conexión: ${err.message}`;
      } finally {
        AppState.apiConfig = origCfg;
      }
    }

    /* Clean and Parse JSON from LLM Response */
    function parseLLMJson(text) {
      let clean = text.trim();
      clean = clean.replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/```\s*$/i, '');
      const first = clean.indexOf('{');
      const last = clean.lastIndexOf('}');
      if (first !== -1 && last !== -1) clean = clean.substring(first, last + 1);
      return JSON.parse(clean);
    }

